# Le Lörd Homes — Environment Variables
# Copy this file to .env and fill in your values before running the app.
# None of these values should be committed to version control.

# WhatsApp business number (international format, e.g. 447700900000)
VITE_WHATSAPP_NUMBER=

# Booking URL for the free discovery call (e.g. Calendly link)
VITE_BOOKING_URL=

# Stripe payment link for the 30-minute consultation (£50)
VITE_STRIPE_PAYMENT_LINK_30=

# Stripe payment link for the 60-minute strategy session (£85)
VITE_STRIPE_PAYMENT_LINK_60=

# Business email address (displayed in footer and contact page)
VITE_EMAIL=

# Business phone number (displayed in footer and contact page)
VITE_PHONE=

# Instagram profile URL (e.g. https://www.instagram.com/lelordhomes)
VITE_INSTAGRAM_URL=
